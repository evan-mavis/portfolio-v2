{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "cpd": "jscpd",
    "analyze": "ANALYZE=true next build --webpack",
    "docs:check": "node scripts/check-agents-md.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run cpd && pnpm run docs:check && pnpm run test:coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jscpd": "^5.3.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
