# No variables are required to run the site locally.
# Copy to .env.local only if you need one of the optional values below.

# Port for `pnpm run dev` / Playwright (default 3000)
# PORT=3000

# Set to "true" to open the bundle analyzer after `next build` (used by `pnpm run analyze`)
# ANALYZE=false

# Set automatically by Vercel; surfaced by /api/health
# VERCEL_GIT_COMMIT_SHA=
